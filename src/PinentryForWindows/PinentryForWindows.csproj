<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pfw</AssemblyName>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ApplicationManifest>Properties/app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>

    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Bruno Sales</Authors>
    <Description>
      A modern native pinentry implementation for GnuPG on Windows. Uses Windows
      Credential UI (CredUI) and Windows Hello for a seamless and secure passphrase/PIN entry
      experience.
    </Description>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Bruno Sales &lt;me@baliestri.dev&gt;</Copyright>
    <RepositoryUrl>https://github.com/baliestri/pinentry-for-windows</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Company>baliestri.dev</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PinentryForWindows.Core/PinentryForWindows.Core.csproj" />
    <PackageReference Include="AssuanLibrary" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinentryForWindows.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
